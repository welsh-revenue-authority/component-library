    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.27",
